---
import { marks } from '../data/demo';
import type { Folder } from '../data/folders';
import { icons } from './icons';

interface Props {
  f: Folder;
  // The Ctrl+Alt number; a row with a number is a button that opens the folder.
  n?: number;
  on?: boolean;
  class?: string;
}
const { f, n, on = false, class: cls } = Astro.props;
const Tag = n && !f.missing ? 'button' : 'div';
const button = Tag === 'button';
---

<li class:list={['row', 'f-row', cls, { missing: f.missing, busy: f.agent?.busy, on }]} data-agent={f.missing ? undefined : f.id}>
  <Tag
    class="r-btn"
    type={button ? 'button' : undefined}
    data-agent={button ? f.id : undefined}
    aria-pressed={button ? String(on) : undefined}
    aria-keyshortcuts={button ? `Control+Alt+${n}` : undefined}
    title={button ? `Ctrl+Alt+${n} to open` : undefined}
  >
    {f.agent ? <span class="r-marks" set:html={marks(f.agent)} /> : <span class="r-marks f-icon" set:html={icons.folder} />}
    <span class="r-names">{f.repo}</span>
    {f.missing ? (
      <span class="f-rm" set:html={icons.close} />
    ) : f.add || f.del ? (
      <span class="f-lc">
        <span class="lc-add">+{f.add}</span> <span class="lc-del">−{f.del}</span>
      </span>
    ) : null}
    <span class="r-where">
      {f.missing ? (
        <>
          <i>missing</i> · {f.parent}
        </>
      ) : (
        `${f.branch} · ${f.parent}`
      )}
    </span>
  </Tag>
</li>

<style is:global>
  .f-icon {
    color: var(--muted);
  }
  .f-lc,
  .f-rm {
    grid-area: when;
    display: flex;
    gap: 5px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .f-rm {
    color: var(--muted);
  }
  .f-rm svg {
    width: 12px;
    height: 12px;
  }
  .f-row.missing .r-names {
    color: var(--muted);
    font-weight: 400;
  }
</style>
