---
import { agents, counts, totals, rows } from '../data/demo';
import { folders, arriving } from '../data/folders';
import FolderRow from './FolderRow.astro';
import { icons } from './icons';

const before = agents.find(a => a.id === 'billing')!;
const after = agents.find(a => a.id === 'docs')!;
const plates = [
  { a: before, cls: 'fs-before' },
  { a: after, cls: 'fs-after' },
];
const base = (p: string) => p.split('/').pop()!;
const dir = (p: string) => p.split('/').slice(0, -1).join('/');
const statusClass = { M: 'modified', A: 'added', U: 'untracked' } as const;
const t = (a: (typeof agents)[number]) => totals(a);
const command = 'kijk ~/code/docs';
const added = 'Added docs. It is open in the window "kijk · Folders".';
---

<figure class="fscene s1 s2 s3" data-fscene>
  <figcaption class="sr-only">
    Demo. In a terminal, <code>{command}</code> prints “{added}” The folders window then shows docs at the end of its
    list, opened on its changes.
  </figcaption>
  <div class="fs-stage" aria-hidden="true" inert>
    <div class="kijk fs-win">
      <div class="k-title">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="k-title-text">kijk · Folders</span>
      </div>
      <div class="k-body">
        <aside class="k-rail">
          <header>Folders <span class="k-count" data-count>{folders.length + 1}</span></header>
          <ol class="rows">
            {folders.map(f => <FolderRow f={f} class={f.id === 'billing' ? 'fs-was' : undefined} />)}
            <FolderRow f={arriving} class="fs-new" />
          </ol>
        </aside>
        <div class="fs-plates">
          {plates.map(({ a, cls }) => {
            const c = a.changes[0];
            return (
              <section class:list={['fs-plate', cls]}>
                  <aside class="k-side">
                    <div class="k-side-head">
                      <span class="k-folder">
                        {a.repo}
                                              </span>
                      <span class="k-icon" set:html={icons.search} />
                      <div class="k-tabs">
                        <button type="button" aria-pressed="false" set:html={icons.folder} />
                        <button type="button" aria-pressed="true" set:html={icons.git} />
                      </div>
                    </div>
                    <div class="k-git">
                      <div class="branchbar">
                        <Fragment set:html={icons.git} />
                        <span class="branch">{a.branch}</span>
                        <span class="lc">
                          <span class="lc-add">+{t(a).add}</span>
                          <span class="lc-del">−{t(a).del}</span>
                        </span>
                      </div>
                      <div class="prline">
                        {a.pr ? (
                          <>
                            <span class="pr-top">
                              <Fragment set:html={icons[a.pr.host]} />
                              <span class="pr-num">
                                {a.pr.host === 'gitlab' ? '!' : '#'}
                                {a.pr.num}
                              </span>
                              <span class="pr-title">{a.pr.title}</span>
                            </span>
                            <span class="chips">
                              <span class:list={['chip', a.pr.checks]}>
                                {a.pr.checks === 'pass' ? <Fragment set:html={icons.check} /> : <span class="dot" />}
                                {a.pr.host === 'gitlab' ? 'Pipeline' : 'Checks'} {a.pr.checks === 'pass' ? 'passed' : 'running'}
                              </span>
                              <span class:list={['chip', { pass: a.pr.review === 'Approved' }]}>{a.pr.review}</span>
                            </span>
                          </>
                        ) : (
                          <span class="pr-none">No pull request for this branch</span>
                        )}
                      </div>
                      <div class="changes">
                        <h3>
                          Changes <span class="n">{a.changes.length}</span>
                        </h3>
                        {a.changes.map((ch, i) => (
                          <div class:list={['item', 'change', { selected: i === 0 }]}>
                            <input type="checkbox" checked={ch.staged} />
                            <span class:list={['letter', statusClass[ch.status]]}>{ch.status}</span>
                            <span class:list={['name', statusClass[ch.status]]}>{base(ch.path)}</span>
                            <span class="dir">{dir(ch.path)}</span>
                            <span class="lc">
                              <span class="lc-add">+{counts(ch).add}</span>
                              <span class="lc-del">−{counts(ch).del}</span>
                            </span>
                          </div>
                        ))}
                      </div>
                      <div class="commit">
                        <textarea rows="2" placeholder="Commit message"></textarea>
                        <label class="check">
                          <input type="checkbox" /> Push after commit
                        </label>
                        <button type="button" disabled>
                          Commit
                        </button>
                      </div>
                    </div>
                  </aside>
                  <div class="k-main">
                    <div class="view">
                      <div class="filetabs">
                        <span class="filetab">
                          {base(c.path)}
                          <Fragment set:html={icons.close} />
                        </span>
                      </div>
                      <div class="diffbar">
                        <span class="path">{c.path}</span>
                        <span class="lc">
                          <span class="lc-add">+{counts(c).add}</span>
                          <span class="lc-del">−{counts(c).del}</span>
                        </span>
                      </div>
                      <div class="code">
                        {rows(c).map(r =>
                          r.kind === 'sep' ? (
                            <div class="ln sep">
                              <span class="gut" />
                              <span class="tx">{r.html}</span>
                            </div>
                          ) : (
                            <div class:list={['ln', r.kind]}>
                              <span class="gut">
                                <span>{r.old ?? ''}</span>
                                <span>{r.new ?? ''}</span>
                              </span>
                              <span class="tx" set:html={r.html} />
                            </div>
                          ),
                        )}
                      </div>
                    </div>
                  </div>
                </section>
            );
          })}
        </div>
      </div>
      <footer class="k-status">
        <span class="k-ver"><i class="dot"></i>kijk</span>
      </footer>
    </div>

    <!-- The terminal borrows the machines scene's styles, which the page always has. -->
    <div class="ms-term fs-term">
      <div class="ms-term-bar">
        <span class="lights"><i></i><i></i><i></i></span>
        <span>Terminal</span>
      </div>
      <div class="ms-term-body">
        <p><span class="ms-ps">~ $</span> <span data-type={command}>{command}</span><span class="ms-caret fs-typing" /></p>
        <p class="ms-out fs-o">{added}</p>
        <p class="ms-out fs-o"><span class="ms-ps">~ $</span> <span class="ms-caret" /></p>
      </div>
    </div>
  </div>
</figure>

<style is:global>
  .fscene {
    position: relative;
    margin: 0;
    padding-bottom: 40px;
    min-width: 0;
  }
  .fs-stage {
    position: relative;
  }
  .fs-win {
    height: 600px;
  }
  .fs-win .k-side {
    display: flex;
  }
  .fs-win .k-tabs button {
    cursor: default;
  }
  .fs-win .commit {
    margin-top: auto;
  }
  .fs-plates {
    display: grid;
    min-height: 0;
  }
  .fs-plate {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: var(--side-w) minmax(0, 1fr);
    min-height: 0;
  }
  .fs-after,
  .s3 .fs-before {
    visibility: hidden;
  }
  .s3 .fs-after {
    visibility: visible;
    animation: k-plate 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fs-was .r-btn {
    background: var(--select);
  }
  .fs-new {
    display: none;
  }
  .s3 .fs-new {
    display: block;
  }
  .s3 .fs-new .r-btn {
    background: var(--select);
  }
  .s3 .fs-was .r-btn {
    background: none;
  }
  .s2 .fs-o {
    display: block;
    animation: ms-line 0.2s ease-out;
  }
  .s2 .fs-typing {
    display: none;
  }

  @media (max-width: 860px) {
    .fs-plate {
      grid-template-columns: minmax(0, 1fr);
    }
    .fs-win .k-main {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .fscene {
      padding-bottom: 0;
    }
    .fs-win {
      height: auto;
    }
    .fs-win .k-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .fs-win .k-rail {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }
    .fs-win .commit {
      display: none;
    }
    .fs-term {
      position: relative;
      right: auto;
      bottom: auto;
      width: 100%;
      margin-top: -20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .s3 .fs-after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const wait = (ms: number) => new Promise(r => setTimeout(r, ms));
  const STEPS = ['s1', 's2', 's3'];

  // The markup ships in the final state, so the scene reads without JavaScript or with reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const scene of document.querySelectorAll<HTMLElement>('[data-fscene]')) {
      const typed = scene.querySelector<HTMLElement>('[data-type]')!;
      const count = scene.querySelector<HTMLElement>('[data-count]')!;
      const fresh = scene.querySelector<HTMLElement>('.fs-new')!;
      const finalCount = count.textContent!;
      let playing = false;

      const reset = () => {
        scene.classList.remove(...STEPS);
        fresh.classList.remove('arrived');
        typed.textContent = '';
        count.textContent = String(+finalCount - 1);
      };

      async function play() {
        if (playing) return;
        playing = true;
        reset();
        scene.classList.add('s1');
        await wait(500);
        for (const ch of typed.dataset.type!) {
          typed.textContent += ch;
          await wait(45 + Math.random() * 55);
        }
        await wait(400);
        scene.classList.add('s2');
        await wait(700);
        scene.classList.add('s3');
        fresh.classList.add('arrived');
        count.textContent = finalCount;
        playing = false;
      }

      let armed = true;
      new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting || !armed) return;
          armed = false;
          play();
        },
        { rootMargin: '0px 0px -35% 0px' },
      ).observe(scene);
      new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) armed = true;
      }).observe(scene);

      reset();
    }
  }
</script>
