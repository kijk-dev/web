---
import Base from '../layouts/Base.astro';
import KijkWindow from '../components/KijkWindow.astro';
import Install from '../components/Install.astro';
import KeysReceipt from '../components/KeysReceipt.astro';
import MachinesScene from '../components/MachinesScene.astro';
import BranchGraph from '../components/BranchGraph.astro';
import ReviewDemo from '../components/ReviewDemo.astro';
import AgentRow from '../components/AgentRow.astro';
import { icons } from '../components/icons';
import type { Agent } from '../data/demo';

const description =
  'kijk is an agent-native code viewer: a small, fast, read-only view of the work of your Claude Code and Codex agents.';
const repo = 'https://github.com/kijk-dev/kijk';

const example = (a: Partial<Agent>) => a as Agent;
const states = [
  {
    a: example({ id: 'busy', names: ['Fix token refresh'], types: ['codex'], repo: 'shop-api', branch: 'fix/token-refresh', busy: true }),
    when: 'just now',
    state: 'Busy.',
    note: 'The agent is working. Its mark pulses.',
  },
  {
    a: example({ id: 'done', names: ['Add VAT to invoices'], repo: 'billing', branch: 'feat/vat', busy: false, finished: true }),
    when: '4m ago',
    state: 'Done.',
    note: 'It finished since you last looked. A blue dot waits for you.',
  },
  {
    a: example({ id: 'shared', names: ['Tidy CLI flags', 'Write the tests'], types: ['claude', 'codex'], working: 'codex', repo: 'cli', branch: 'main', busy: true }),
    when: '1m ago',
    state: 'Shared.',
    note: 'Two agents, one folder. Only the mark of the one that works pulses.',
  },
];
---

<Base title="kijk — an agent-native code viewer" description={description}>
  <header class="top">
    <a href="/" class="brand" aria-label="kijk home">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="/kijk-logo-dark.svg" />
        <img src="/kijk-logo.svg" alt="kijk" width="62" height="50" />
      </picture>
    </a>
    <nav aria-label="Site">
      <a href="#rail">How it works</a>
      <a href={repo} target="_blank" rel="noopener" class="gh"><Fragment set:html={icons.github} />GitHub</a>
    </nav>
  </header>

  <main>
    <section class="service" aria-labelledby="hero-title">
      <h1 id="hero-title"><span>See what agents changed.</span> <span class="hl">Anywhere.</span></h1>
      <div class="pitch">
        <p class="lead">
          kijk is an agent-native code viewer. It lists the Claude Code and Codex agents on this computer and on remote
          machines. Pick one to see its files, its diff and its git state.
        </p>
        <Install />
        <p class="aside">Or with Go:<br /><code>go install github.com/kijk-dev/kijk@latest</code></p>
        <p class="aside">
          Works with <span class="mk"><Fragment set:html={icons.claude} />Claude Code</span> and <span class="mk"
            ><Fragment set:html={icons.codex} />Codex</span
          >. Pi is planned.
        </p>
      </div>
      <div class="plate-stage">
        <KijkWindow />
      </div>
    </section>

    <section id="rail" class="course" aria-labelledby="rail-title">
      <div class="words">
        <h2 id="rail-title">Every agent in one list.</h2>
        <p>
          kijk finds the Claude Code and Codex agents that run on your machine. You never open a project by hand. The
          newest work comes to the top. Rows appear, change and go as agents start, work and stop.
        </p>
        <ul class="facts">
          <li>Agents in the same folder share one row, also a Claude Code and a Codex agent.</li>
          <li>An agent in a git worktree gets its own.</li>
          <li><kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>1</kbd> to <kbd>9</kbd> opens the first nine.</li>
        </ul>
      </div>
      <ul class="states rows" aria-label="Row states">
        {
          states.map(x => (
            <AgentRow a={x.a} when={x.when}>
              <p>
                <b>{x.state}</b> {x.note}
              </p>
            </AgentRow>
          ))
        }
      </ul>
    </section>

    <section id="review" class="course" aria-labelledby="review-title">
      <div class="words">
        <h2 id="review-title">Review every change.</h2>
        <p>
          Files open read-only, with syntax colours. The diff shows what changed, with line counts like
          <span class="lc"><span class="lc-add">+40</span> <span class="lc-del">−12</span></span>. Markdown shows
          rendered, with a bar beside each changed block.
        </p>
        <p>When an agent writes to the open file, kijk reloads it and keeps your place.</p>
        <ul class="facts">
          <li>Big files scroll smoothly. kijk draws only the lines on the screen.</li>
          <li>One click previews a file in a tab. A double click keeps it open.</li>
        </ul>
      </div>
      <ReviewDemo />
    </section>

    <section id="branch" class="course" aria-labelledby="branch-title">
      <div class="words">
        <h2 id="branch-title">Know where the branch stands.</h2>
        <p>
          The branch graph puts the agent's branch next to main and the pull request target, from the commit where they
          split.
        </p>
        <p>See what the agent committed, what is not pushed yet, and whether main moved on.</p>
        <ul class="facts">
          <li>
            <span class="sw sw-cur"></span> this branch, <span class="sw sw-main"></span> main. A pull request to another
            branch adds its own line.
          </li>
          <li>Click a commit to see the files it changed.</li>
        </ul>
      </div>
      <figure class="gslip" aria-label="The branch graph in the Git tab of kijk">
        <div class="kijk gslip-win">
          <div class="branchbar">
            <Fragment set:html={icons.git} /><span class="branch">feat/vat</span>
            <span class="pill">↑1</span><span class="tool" aria-hidden="true">Push</span>
          </div>
          <BranchGraph note={{ h1: 'Not pushed yet', m1: 'main moved on', f: 'They split here' }} />
        </div>
        <figcaption>The branch graph, in the Git tab. Click a commit to see its files.</figcaption>
      </figure>
    </section>

    <section id="ship" class="course" aria-labelledby="ship-title">
      <div class="words">
        <h2 id="ship-title">Send it, safely.</h2>
        <p>
          Stage, commit, push and fetch from the Git tab. There is no discard, checkout, pull or stash, so a click
          cannot destroy an agent's work.
        </p>
        <p>
          kijk runs your own <code>git</code>, so your config, credentials and hooks apply. With <code>gh</code> or <code>glab</code>, you also see the pull request of the branch, its checks and its review. kijk never stores a token.
        </p>
      </div>
      <figure class="slip" aria-label="The Git tab of kijk">
        <div class="kijk slip-win">
          <div class="k-side" style="display:flex">
            <div class="branchbar">
              <Fragment set:html={icons.git} /><span class="branch">feat/vat</span>
              <span class="lc"><span class="lc-add">+18</span><span class="lc-del">−2</span></span>
              <span class="pill">↑1</span><span class="tool" aria-hidden="true">Push</span>
            </div>
            <div class="prline">
              <span class="pr-top"><Fragment set:html={icons.github} /><span class="pr-num">#57</span><span class="pr-title">Add VAT to invoices</span></span>
              <span class="chips"><span class="chip pass"><Fragment set:html={icons.check} />Checks passed</span><span class="chip pass">Approved</span></span>
            </div>
            <div class="changes">
              <h3>Changes <span class="n">2</span></h3>
              <div class="item change"><input type="checkbox" checked disabled aria-label="Staged" /><span class="letter modified">M</span><span class="name modified">invoice.ts</span><span class="dir">src</span><span class="lc"><span class="lc-add">+9</span><span class="lc-del">−1</span></span></div>
              <div class="item change"><input type="checkbox" disabled aria-label="Not staged" /><span class="letter modified">M</span><span class="name modified">rates.ts</span><span class="dir">src/tax</span><span class="lc"><span class="lc-add">+4</span><span class="lc-del">−1</span></span></div>
            </div>
            <div class="commit">
              <textarea rows="2" aria-label="Commit message" readonly>Add VAT to invoice totals</textarea>
              <span class="check"><input type="checkbox" checked disabled /> Push after commit</span>
              <span class="slip-btn">Commit</span>
            </div>
          </div>
        </div>
        <figcaption>The Git tab. On a wide screen, try it on a demo agent above.</figcaption>
      </figure>
    </section>

    <section id="machines" class="course wide" aria-labelledby="machines-title">
      <div class="words">
        <h2 id="machines-title">Add a machine to see its agents.</h2>
        <div>
          <p>
            Some agents run on a VM or a box without a screen. Add the machine once, with an alias from your SSH config
            or <code>user@host</code>. Its agents join the same list, under their own header.
          </p>
          <p>
            Read their files and diffs. Stage, commit, push and fetch there. kijk uses your own <code>ssh</code>, keys
            and known hosts, and copies itself to the machine when needed.
          </p>
        </div>
      </div>
      <MachinesScene />
    </section>

    <section id="keys" class="course" aria-labelledby="keys-title">
      <div class="words">
        <h2 id="keys-title">Your IntelliJ keys.</h2>
        <p>
          kijk uses the IntelliJ default keys, so your hands already know it. Every common action works without the
          mouse.
        </p>
        <p>
          Some keys belong to the browser in a normal tab. For those, kijk has a second key, and the tooltip shows the
          one that works in your window.
        </p>
      </div>
      <KeysReceipt />
    </section>

    <section class="close" aria-labelledby="close-title">
      <h2 id="close-title">Install kijk in one line.</h2>
      <p>
        Then run <code>kijk</code>, and your agents are in the list. Or <code class="nw">kijk ~/code/api</code> for just a
        folder.
      </p>
      <div class="close-ticket"><Install big /></div>
      <p class="close-links">
        <a href={repo} target="_blank" rel="noopener">Source and docs on GitHub</a>
      </p>
    </section>
  </main>

  <footer class="foot">
    <span>kijk is Dutch for “look”.</span>
    <span>MIT licensed.</span>
    <a href={repo} target="_blank" rel="noopener">GitHub</a>
  </footer>
</Base>

<style>
  .top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 1680px;
    margin: 0 auto;
    padding: 18px clamp(20px, 4vw, 48px) 0;
  }
  .brand {
    display: block;
    line-height: 0;
  }
  .brand img {
    height: 44px;
    width: auto;
  }
  nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 28px);
    font-size: 15px;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--blue);
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .service {
    display: grid;
    grid-template-columns: minmax(300px, 370px) minmax(0, 1fr);
    gap: 40px clamp(28px, 3vw, 44px);
    max-width: 1680px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 56px) 0 0 clamp(20px, 4vw, 48px);
  }
  h1 {
    grid-column: 1 / -1;
    margin: 0;
    padding-right: clamp(20px, 4vw, 48px);
    font-size: clamp(2.6rem, 6.4vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }
  h1 span {
    display: block;
  }
  .hl {
    color: var(--ember-deep);
  }
  @media (prefers-color-scheme: dark) {
    .hl {
      color: var(--ember);
    }
  }
  .lead {
    margin: 0 0 28px;
    color: var(--muted);
    max-width: 34ch;
  }
  .aside {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .mk {
    color: var(--text);
    white-space: nowrap;
  }
  .mk :global(svg) {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    vertical-align: -2px;
  }
  .aside + .aside {
    margin-top: 6px;
  }
  .aside code {
    font-size: 13px;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .plate-stage {
    min-width: 0;
    height: clamp(560px, calc(100svh - 120px), 800px);
  }
  .plate-stage :global(.kijk) {
    height: 100%;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: 0 0 0 1px #b9bfc6, 0 2px 4px rgb(25 29 35 / 0.08), 0 40px 80px -24px rgb(25 29 35 / 0.38);
  }
  /* The window's panels share the page's Paper, so the hero copy needs a firmer edge to stand off it. */
  .plate-stage :global(.k-title) {
    background: #e6eaee;
  }
  @media (prefers-color-scheme: dark) {
    .plate-stage :global(.kijk) {
      box-shadow: 0 0 0 1px #3a3f46, 0 40px 90px -24px rgb(0 0 0 / 0.75);
    }
    .plate-stage :global(.k-title) {
      background: #23272d;
    }
  }

  .course {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(80px, 11vw, 150px) clamp(20px, 4vw, 48px) 0;
  }
  h2 {
    margin: 0 0 16px;
    font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2rem);
    line-height: 1.12;
  }
  .words p {
    margin: 0 0 14px;
    max-width: 44ch;
  }
  .words code {
    font-size: 0.92em;
  }
  .facts {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: 15px;
    color: var(--muted);
  }
  .facts li {
    padding-left: 18px;
    position: relative;
  }
  .facts li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.7em;
    width: 7px;
    height: 1px;
    background: var(--edge);
  }
  kbd {
    font-size: 0.85em;
    padding: 1px 5px;
    border: 1px solid var(--hairline);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--win);
    color: var(--text);
  }

  .nw {
    white-space: nowrap;
  }

  .states {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
  }
  .states :global(.row) {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    border-bottom: 1px solid var(--hairline);
  }
  .states :global(.r-btn) {
    border-bottom: 0;
    background: var(--panel);
  }
  .states p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .states b {
    color: var(--text);
  }

  .lc {
    font-family: var(--mono);
    font-variation-settings: 'MONO' 1;
    font-size: 0.92em;
    white-space: nowrap;
  }
  .lc-add {
    color: var(--added);
  }
  .lc-del {
    color: var(--removed);
  }

  .course.wide {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .course.wide .words {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
  }

  .sw {
    display: inline-block;
    width: 14px;
    height: 3px;
    border-radius: 2px;
    vertical-align: middle;
    margin: 0 2px 2px 0;
  }
  .sw-cur {
    background: var(--blue);
  }
  .sw-main {
    background: var(--lane-main);
  }

  .gslip {
    margin: 0;
    width: min(100%, 400px);
  }
  .gslip-win {
    display: block;
    overflow: visible;
    padding-bottom: 6px;
  }
  .gslip-win .branchbar {
    border-radius: 12px 12px 0 0;
    background: var(--panel);
  }
  .gslip figcaption {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted);
  }

  .slip {
    margin: 0;
    justify-self: start;
    width: min(100%, 380px);
  }
  .slip-win {
    display: block;
  }
  .slip-win .k-side {
    border-right: 0;
  }
  .slip-btn {
    display: block;
    text-align: center;
    font-weight: 600;
    padding: 4px;
    border-radius: 4px;
    background: var(--blue-fill);
    color: #fff;
  }
  .slip figcaption {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted);
  }

  .close {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(110px, 14vw, 190px) clamp(20px, 4vw, 48px) 0;
    text-align: center;
  }
  .close h2 {
    font-size: clamp(2rem, 1.4rem + 1.4vw, 2.6rem);
  }
  .close > p {
    color: var(--muted);
    margin: 0 auto 30px;
    max-width: 40ch;
  }
  .close-ticket {
    text-align: left;
  }
  .close-links {
    margin-top: 26px;
    font-size: 15px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    max-width: 1200px;
    margin: clamp(90px, 10vw, 140px) auto 0;
    padding: 22px clamp(20px, 4vw, 48px) 36px;
    border-top: 1px solid var(--hairline);
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 1060px) {
    .service {
      grid-template-columns: minmax(0, 1fr);
      padding-right: clamp(20px, 4vw, 48px);
    }
    .pitch {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 40px;
      align-items: start;
    }
    h1 {
      padding-right: 0;
    }
    .pitch .lead {
      grid-column: 1;
    }
    .pitch :global(.order-wrap) {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: start;
    }
    .pitch .aside {
      grid-column: 1;
    }
    .plate-stage :global(.kijk) {
      border-radius: 12px;
    }
    .plate-stage {
      height: clamp(520px, 72svh, 720px);
    }
    .course,
    .course.wide .words {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .pitch {
      display: block;
    }
    .lead {
      margin-bottom: 22px;
    }
    .plate-stage {
      height: 640px;
      margin-top: 32px;
    }
    nav a:not(.gh) {
      display: none;
    }
    .states :global(.row) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-bottom: 10px;
    }
    .states p {
      padding: 0 12px 0 32px;
    }
  }
</style>
